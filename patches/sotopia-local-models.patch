+def _strip_thinking_tags(content: str | None) -> str | None:
+    if content is None:
+        return None
+    cleaned = re.sub(r"(?is)<think>.*?</think>", "", content).strip()
+    fenced = re.search(r"(?is)```(?:json)?\s*(.*?)\s*```", cleaned)
+    if fenced:
+        cleaned = fenced.group(1).strip()
+    starts = [pos for pos in (cleaned.find("{"), cleaned.find("[")) if pos != -1]
+    if starts:
+        start = min(starts)
+        cleaned = cleaned[start:].strip()
+    if cleaned.startswith("{") and "}" in cleaned:
+        cleaned = cleaned[: cleaned.rfind("}") + 1]
+    elif cleaned.startswith("[") and "]" in cleaned:
+        cleaned = cleaned[: cleaned.rfind("]") + 1]
+    return cleaned.strip()
